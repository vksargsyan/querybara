{
  "name": "@querybara/sync",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Structure diff, data compare and sync script generation for SQL engines and MongoDB.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration --testTimeout=120000 --hookTimeout=120000"
  },
  "dependencies": {
    "@querybara/core": "workspace:*",
    "@querybara/mongo-tools": "workspace:*",
    "@querybara/sql-tools": "workspace:*"
  },
  "devDependencies": {
    "@querybara/driver-mongodb": "workspace:*",
    "@querybara/driver-mysql": "workspace:*",
    "@querybara/driver-postgres": "workspace:*",
    "@querybara/driver-sql-base": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
