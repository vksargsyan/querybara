# gem install mongo
# Set MONGODB_URI to your connection string, e.g. mongodb://localhost:27017
require "mongo"

client = Mongo::Client.new(ENV.fetch("MONGODB_URI"), database: "shop")
collection = client["orders"]
filter = {
  "status" => { "$in" => ["A", "D"] },
  "qty" => { "$gte" => 5, "$lt" => BSON::Int64.new(100) },
  "item.sku" => BSON::Regexp::Raw.new("^ab", "i"),
}
collection.find(
  filter,
  projection: { "status" => 1, "qty" => 1, "_id" => 0 },
  sort: { "qty" => -1, "status" => 1 },
  skip: 10,
  limit: 20,
  collation: { "locale" => "en", "strength" => 2, "numericOrdering" => true },
  hint: { "status" => 1 },
  max_time_ms: 5000
).each do |document|
  puts document
end
client.close
