# gem install mongo
# Set MONGODB_URI to your connection string, e.g. mongodb://localhost:27017
require "mongo"

client = Mongo::Client.new(ENV.fetch("MONGODB_URI"), database: "shop")
collection = client["types"]
filter = {
  "oid" => BSON::ObjectId.from_string("65a1b2c3d4e5f60718293a4b"),
  "date" => Time.utc(2024, 1, 2, 3, 4, 5, 678000),
  "far" => Time.at(0, 253402300800000, :millisecond).utc,
  "dec" => BSON::Decimal128.new("1234.5600"),
  "long" => BSON::Int64.new(9007199254740993),
  "smallLong" => BSON::Int64.new(5),
  "int" => 42,
  "double" => 1.0,
  "frac" => 2.5,
  "nan" => Float::NAN,
  "inf" => Float::INFINITY,
  "nzero" => -0.0,
  "bin" => BSON::Binary.new(["01020304"].pack("H*"), :generic),
  "userBin" => BSON::Binary.new(["00"].pack("H*"), :user),
  "uuid" => BSON::Binary.from_uuid("a8098c1a-f86e-11da-bd1a-00112444be1e"),
  "re" => BSON::Regexp::Raw.new("^ab+c", "i"),
  "reX" => BSON::Regexp::Raw.new("a b \# comment", "sx"),
  "ts" => BSON::Timestamp.new(1700000000, 7),
  "tsBig" => BSON::Timestamp.new(4294967295, 4294967295),
  "min" => BSON::MinKey.new,
  "max" => BSON::MaxKey.new,
  "nul" => nil,
  "t" => true,
  "s" => "it's \"quoted\" \\ $var\n\ttab \u0001 é 😀",
  "nested" => { "a" => [1, "x", { "b" => nil }], "a.b" => 1 },
  "list" => { "0" => "a", "1" => "b" },
  "emptyDoc" => {},
  "emptyArr" => [],
  "single" => [nil],
  "code" => BSON::Code.new("function() { return 1; }"),
  "ref" => BSON::DBRef.new({ "$ref" => "things", "$id" => BSON::ObjectId.from_string("65a1b2c3d4e5f60718293a4c") }),
}
collection.find(filter).each do |document|
  puts document
end
client.close
